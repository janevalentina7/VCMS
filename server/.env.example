# ─────────────────────────────────────────────────────────────
# VCMS API - environment configuration
# Copy to .env and adjust. Never commit real secrets.
# ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ── Database ────────────────────────────────────────────────
# local development (zero-config, file based):
DB_CLIENT=better-sqlite3
DB_FILENAME=./data/vcms.sqlite
# production (PostgreSQL) - commented example:
# DB_CLIENT=pg
# DATABASE_URL=postgres://vcms_user:strong_password@localhost:5432/vcms

# ── Authentication ──────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_long_000000
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_long_000000
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# ── Cookies / CORS ──────────────────────────────────────────
# auto = derive Secure flag from the request protocol (X-Forwarded-Proto aware)
COOKIE_SECURE=auto
COOKIE_SAME_SITE=lax
# comma separated list of allowed browser origins (empty = same-origin only)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Uploads ─────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5

# ── Platform / branding ─────────────────────────────────────
APP_NAME=Village Complaint Management System
APP_ORG=Government of Tamil Nadu
APP_TAGLINE=Digital Grievance Redressal Portal
COMPLAINT_ID_PREFIX=VCMS
